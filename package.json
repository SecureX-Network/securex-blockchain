{
  "name": "ctn-blockchain",
  "version": "0.1.0",
  "description": "Credential Trust Network - Permissioned Blockchain for Digital Credential Verification",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli/index.js start",
    "dev": "ts-node src/cli/index.ts",
    "test": "jest --forceExit",
    "test:unit": "jest --testPathPattern=tests/unit --forceExit",
    "test:integration": "jest --testPathPattern=tests/integration --forceExit",
    "test:security": "jest --testPathPattern=tests/security --forceExit",
    "test:network": "jest --testPathPattern=tests/network --forceExit",
    "demo": "ts-node scripts/demo.ts",
    "demo:data": "ts-node scripts/demo-data.ts",
    "demo:attack": "ts-node scripts/attack-simulation.ts",
    "benchmark": "ts-node scripts/benchmark.ts",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.16.0",
    "commander": "^12.0.0",
    "uuid": "^9.0.0",
    "chalk": "^4.1.2",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/ws": "^8.5.10",
    "@types/uuid": "^9.0.7",
    "@types/jest": "^29.5.11",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "@types/node": "^20.10.0"
  }
}
