# SecureX Blockchain — Environment Configuration
# Copy this file to `.env` and adjust values as needed.
# NOTE: Never commit `.env` or any secrets. This file only documents available keys.

# --- Node identity ---
# CTN_NODE_ID is derived from the generated key. Leave empty to use config-derived value.

# --- API server ---
CTN_API_HOST=0.0.0.0
CTN_API_PORT=4001

# --- P2P network ---
CTN_HOST=0.0.0.0
CTN_P2P_PORT=3001

# Bootstrap/peer P2P addresses (comma-separated ws:// URLs)
# CTN_BOOTSTRAP_NODES=ws://localhost:3001,ws://localhost:3002

# --- Validators ---
# Comma-separated list of validator node IDs (SHA-256 of public key).
# CTN_VALIDATORS=...

# --- Storage ---
CTN_DATA_DIR=.ctn/data

# --- Consensus ---
# Permissioned Proof of Authority (single proposer). Do NOT change semantics.
CTN_BLOCK_INTERVAL=5000
CTN_PROPOSER_TIMEOUT_MS=5000

# --- Network limits ---
CTN_MAX_PEERS=50
CTN_HEARTBEAT_MS=30000

# --- Protocol ---
CTN_PROTOCOL_VERSION=2.0
CTN_GENESIS_TIME=2026-01-01T00:00:00.000Z

# --- API CORS ---
CTN_CORS_ENABLED=true
# Comma-separated allowed origins, or * for any.
CTN_ALLOWED_ORIGINS=*

# --- Request limits ---
CTN_REQUEST_LIMIT_BYTES=2097152

# --- Logging ---
CTN_LOG_LEVEL=info
# CTN_DEBUG=true enables verbose debug logging
